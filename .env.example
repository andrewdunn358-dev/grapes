# Copy to .env on the NAS and change both passwords (long random strings are fine,
# nobody types these - she only uses the app password she picks on first visit).
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-another-long-random

# Port the app listens on at the NAS (http://NAS-IP:8080)
APP_PORT=8080

# Only if using the bundled cloudflared (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=
